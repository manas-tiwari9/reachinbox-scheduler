# ══════════════════════════════════════════════════════════════
#  ReachInbox Email Scheduler — Environment Variables
#  Copy this file to .env in the backend/ folder and fill in values
# ══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (MySQL) ─────────────────────────────────────────
# With Docker:  mysql://root:password@localhost:3306/reachinbox
# Manual:       mysql://YOUR_USER:YOUR_PASS@localhost:3306/reachinbox
DATABASE_URL=mysql://root:password@localhost:3306/reachinbox

# ─── Redis ───────────────────────────────────────────────────
# BullMQ + rate-limit counters both use Redis.
# With Docker:  redis://localhost:6379
# Manual:       redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ───────────────────────────────────────────
# Full-text search for emails.
# With Docker:  http://localhost:9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ─── Google OAuth ────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── JWT Session ─────────────────────────────────────────────
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS) ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Slack OAuth ─────────────────────────────────────────────
# 1. Go to https://api.slack.com/apps → Create New App
# 2. Add OAuth Scope: chat:write
# 3. Add Redirect URL: http://localhost:3001/api/slack/callback
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback

# ─── Scheduler Config ────────────────────────────────────────
# Max emails per hour per sender (Redis-backed counter).
# When exceeded: jobs are rescheduled to next hour, Slack notified.
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Number of emails the BullMQ worker processes in parallel.
WORKER_CONCURRENCY=5

# Minimum milliseconds between individual email sends (throttle).
# BullMQ limiter: max 1 job per EMAIL_DELAY_MS per queue.
EMAIL_DELAY_MS=2000

# ─── Ethereal Email (auto-created if left blank) ─────────────
# If blank, the app auto-creates a test Ethereal account on startup.
# You'll see the credentials printed in the backend logs.
# https://ethereal.email/create
ETHEREAL_USER=
ETHEREAL_PASS=
